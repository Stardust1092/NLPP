# ── 统一换行符（Windows/Mac/Linux 跨平台协作）────────────────
* text=auto

# ── Python / JSON / Markdown 强制 LF ────────────────────────
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.env*  text eol=lf

# ── 二进制文件（不做换行转换）────────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
