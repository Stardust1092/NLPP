# ============================================================
#  StoryWeaver · .gitignore
# ============================================================

# ── 绝对禁止入库（安全敏感）───────────────────────────────────
.env
*.key
*.secret

# ── Python 运行产物 ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python

# ── 虚拟环境 ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── 游戏运行日志（自动生成，不需要版本控制）────────────────────
logs/

# ── IDE / 编辑器 ───────────────────────────────────────────
.idea/
.vscode/
*.iml
*.suo
*.user
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── 大文件 / 课程 PDF（可选入库，但 >40MB 超过 Blackboard 限制）
# project intro.pdf
# COMP5423 NLP Group Project Introduction-2026.pdf

# ── 构建 / 分发 ────────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/

# ── 测试覆盖率 ─────────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/

# ── JetBrains 内部评估工具 ─────────────────────────────────
.jbeval/

# ── Vercel ──────────────────────────────────────────────────
.vercel/

# ── Claude Code 内部配置（可选：若不想同步给队友则忽略）──────────
# .claude/
